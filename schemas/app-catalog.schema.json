{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qedartifacts.org/schemas/app-catalog-v1.json",
  "title": "QED-AI public application catalog",
  "type": "object",
  "required": ["schemaVersion", "domain", "apps"],
  "properties": {
    "schemaVersion": {"const": 1},
    "domain": {"type": "string"},
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "name", "summary", "status", "version", "path"],
        "properties": {
          "slug": {"type": "string"},
          "name": {"type": "string"},
          "summary": {"type": "string"},
          "status": {"type": "string"},
          "version": {"type": ["string", "null"]},
          "path": {"type": ["string", "null"]}
        }
      }
    }
  }
}

